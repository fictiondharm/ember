# FleetGrid configuration. Copy to .env and adjust as needed.
# Every value below is the built-in default, so an empty .env behaves identically.

# ---------- server ----------
PORT=4000
HOST=0.0.0.0

# Where the JSON collections live. Created on boot and re-seeded when empty.
DATA_DIR=./server/data

# Comma-separated allowed browser origins, or * for any (handy for the 3-device demo).
CORS_ORIGIN=*

# Dead websocket client reaping interval, ms.
WS_HEARTBEAT_MS=30000

# Re-seed automatically when DATA_DIR is empty. Set false to keep existing data.
AUTO_SEED=true

# ---------- web ----------
# Backend origin the browser talks to. Leave unset to auto-derive it from the
# page hostname (works for multi-device demos on one network). Set it explicitly
# when the API is on a different machine:
#   VITE_API_URL=http://192.168.1.20:4000
VITE_API_URL=
