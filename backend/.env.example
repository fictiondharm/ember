# FleetGrid Backend — Environment Configuration Template
# -------------------------------------------------------
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# .env is gitignored and must NEVER be committed.
# -------------------------------------------------------

# ── Database ────────────────────────────────────────────
# Local development: use SQLite (no setup required)
DATABASE_URL=sqlite:///./fleetgrid.db

# Production (Render): set this to the Render PostgreSQL connection string.
# Render injects this automatically when you use render.yaml (fromDatabase reference).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Note: Render may provide postgres:// — the app converts it to postgresql:// automatically.
# DATABASE_URL=postgresql://fleetgrid_user:PASSWORD@dpg-xxx.oregon-postgres.render.com/fleetgrid

# ── Application ─────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# ── CORS ────────────────────────────────────────────────
# Local development: use * to allow all origins.
# Production: replace with your frontend URL(s), comma-separated.
# Example: https://fleetgrid-control-tower.onrender.com,https://fleetgrid-driver.onrender.com
CORS_ORIGINS=*

# ── PostgreSQL Connection Pool ───────────────────────────
# Only applies when DATABASE_URL is a PostgreSQL URL.
# Ignored for SQLite.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── ElevenLabs (driver voice incident reporting) ─────────
# Get from: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=

# ── Dodo Payments (capacity reservation checkout) ────────
# Get from: https://dodopayments.com → Dashboard → API Keys
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=

# ── EVM Blockchain Proof Anchoring ───────────────────────
# PRD Non-Negotiable #7: Never fake blockchain confirmation.
# proof_status remains PENDING if these are not set.
# Supported: Sepolia testnet, Polygon Amoy testnet
EVM_RPC_URL=
EVM_PRIVATE_KEY=
EVM_PROOF_CONTRACT_ADDRESS=
