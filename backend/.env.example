# FleetGrid Backend — Local Environment Configuration
# -------------------------------------------------------
# STEP 1: Choose your database (pick ONE of the options below)

# OPTION A: Neon Postgres (Recommended — free cloud Postgres, works from Render too)
# 1. Go to https://neon.tech → create account → create project "fleetgrid"
# 2. Click "Connection string" and copy it (starts with postgresql://...)
# 3. Paste it below, replacing the entire DATABASE_URL value:
# DATABASE_URL=postgresql://fleetgrid_user:YOUR_PASSWORD@ep-xxx.us-east-1.aws.neon.tech/fleetgrid?sslmode=require

# OPTION B: Local PostgreSQL (if you installed PostgreSQL locally)
# DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/fleetgrid

# OPTION C: SQLite — no setup needed, zero config (for offline dev only)
DATABASE_URL=sqlite:///./fleetgrid.db

# -------------------------------------------------------
# Application
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# CORS — allow all for multi-laptop hackathon setup
CORS_ORIGINS=*

# Connection pool (only applies to PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# -------------------------------------------------------
# ElevenLabs (driver voice incident reporting)
# Get from: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=

# -------------------------------------------------------
# Dodo Payments (capacity reservation checkout)
# Get from: https://dodopayments.com → Dashboard → API Keys
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=

# -------------------------------------------------------
# EVM Blockchain Proof Anchoring (Sepolia / Polygon Amoy testnet)
# PRD Non-Negotiable #7: Never fake blockchain confirmation.
# proof_status will remain PENDING if these are not set.
EVM_RPC_URL=
EVM_PRIVATE_KEY=
EVM_PROOF_CONTRACT_ADDRESS=
